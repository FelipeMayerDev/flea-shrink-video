{
  "schemaVersion": 1,
  "id": "felipemayerdev.shrink-video",
  "name": "Shrink Video",
  "version": "0.3.0",
  "author": "Felipe Mayer",
  "license": "MIT",
  "description": "Shrink videos with ffmpeg: pick format, resolution, frame rate and quality. Encodes in the background and notifies when done.",
  "kinds": ["menu-action"],
  "menuActions": [
    {"id": "shrink", "label": "Shrink Video…", "glyph": "play",
     "when": {"minItems": 1, "maxItems": 64, "folders": false, "mime": ["video/*"]}}
  ],
  "mark": "mark.svg",
  "access": ["selection", "notify", "exec:ffmpeg", "exec:systemd-run", "exec:omarchy-menu-select"],
  "entryPoints": {"run": "plugin.py"}
}
